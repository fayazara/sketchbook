---
/** The sun and moon in the margin of the desk. Click to change the time of day. */
---

<button class="skybody" type="button" data-skybody aria-label="Change the time of day" title="change the time of day">
	<img class="skybody__sun" src="/art/sun.webp" width="64" height="66" alt="" draggable="false" />
	<img class="skybody__moon" src="/art/moon.webp" width="62" height="66" alt="" draggable="false" />
</button>
