---
import Base from "../layouts/Base.astro";
import FeedItem from "../components/FeedItem.astro";
import Empty from "../components/Empty.astro";
import { loadFeed } from "../lib/feed";

const { items, hints } = await loadFeed(["talks"], { limit: 100 });
if (Astro.cache?.enabled) for (const h of hints) Astro.cache.set(h as never);
---

<Base title="Talks" description="Conference talks, meetups and workshops.">
	{items.length === 0 ? <Empty title="No talks listed yet" text="Stage time will show up here." /> : (
		<div class="feed">
			{items.map((item, i) => <FeedItem item={item} index={i} />)}
		</div>
	)}
</Base>
