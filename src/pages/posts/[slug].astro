---
import { getEmDashEntry, getSeoMeta, decodeSlug, getSiteSettings } from "emdash";
import { Image, PortableText } from "emdash/ui";
import Base from "../../layouts/Base.astro";
import { formatDate } from "../../utils/locale";
import { formatReadingTime, getReadingTime } from "../../utils/reading-time";
import { resolveBlogSiteIdentity } from "../../utils/site-identity";
import "../../styles/prose.css";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return Astro.rewrite("/404");

const { entry: post, cacheHint } = await getEmDashEntry("posts", slug);
if (!post) return Astro.rewrite("/404");
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

function getImageUrl(img: unknown): string | undefined {
	if (!img || typeof img !== "object") return undefined;
	const image = img as Record<string, unknown>;
	if (typeof image.src === "string" && image.src) {
		return image.src.startsWith("http") ? image.src : `${Astro.url.origin}${image.src}`;
	}
	const meta = image.meta as Record<string, unknown> | undefined;
	const storageKey =
		(typeof meta?.storageKey === "string" ? meta.storageKey : undefined) ||
		(typeof image.id === "string" ? image.id : undefined);
	return storageKey ? `${Astro.url.origin}/_emdash/api/media/file/${storageKey}` : undefined;
}

const { siteTitle } = resolveBlogSiteIdentity(await getSiteSettings());
const seo = getSeoMeta(post, {
	siteTitle,
	siteUrl: Astro.url.origin,
	path: Astro.url.pathname.replace(/\/$/, ""),
	defaultOgImage: getImageUrl(post.data.featured_image),
});

const publishedAt = post.data.publishedAt ?? null;
const readingTime = formatReadingTime(getReadingTime(post.data.content));
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	image={seo.ogImage}
	canonical={seo.canonical}
	robots={seo.robots}
	type="article"
	publishedTime={post.data.publishedAt?.toISOString() ?? null}
	modifiedTime={post.data.updatedAt.toISOString()}
	content={{ collection: "posts", id: post.data.id, slug }}
	active="posts"
	compact
>
	<article class="article">
		<header class="article__head">
			<h1 class="article__title" {...post.edit.title}>{post.data.title}</h1>
			<p class="article__meta">
				{publishedAt && <time datetime={publishedAt.toISOString()}>{formatDate(publishedAt, "long")}</time>}
				<span aria-hidden="true">·</span>
				<span>{readingTime}</span>
			</p>
		</header>

		{post.data.featured_image && (
			<div class="article__image" {...post.edit.featured_image}>
				<Image image={post.data.featured_image} sizes="(min-width: 700px) 680px, 100vw" priority />
			</div>
		)}

		<div class="prose" {...post.edit.content}>
			<PortableText value={post.data.content} />
		</div>
	</article>
</Base>
